{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "craftwithintent-web",
  "main": "./worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "craftwithintent.com", "custom_domain": true },
    { "pattern": "www.craftwithintent.com", "custom_domain": true }
  ]
}
