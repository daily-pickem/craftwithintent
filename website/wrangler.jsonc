{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "craftwithintent-web",
  "account_id": "eeedec8928f844e612448e4d3c07c755",
  "main": "./worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "SUBSCRIBERS_R2",
      "bucket_name": "quip-storage"
    }
  ],
  "routes": [
    { "pattern": "craftwithintent.com", "custom_domain": true },
    { "pattern": "www.craftwithintent.com", "custom_domain": true }
  ]
}
