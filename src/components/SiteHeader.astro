---
import { url } from '../lib/site';

export type NavSection = 'essays' | 'series' | 'products' | 'tools' | 'founders';

interface Props {
  current?: NavSection;
}

const { current } = Astro.props;

const navLinks: { id: NavSection; label: string; href: string }[] = [
  { id: 'essays', label: 'Essays', href: url('#dispatches') },
  { id: 'series', label: 'Series', href: url('series/') },
  { id: 'products', label: 'Products', href: url('products/') },
  { id: 'tools', label: 'Tools', href: url('tools/') },
  { id: 'founders', label: 'Founders', href: url('founders/') },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href={url('/')} aria-label="Craft with Intent, home" class="lockup">
      <svg class="lockup-mark" width="30" height="30" viewBox="-4 -4 108 108" aria-hidden="true">
        <g transform="rotate(-12 50 50)" fill="none" stroke="currentColor" stroke-linecap="round">
          <path d="M50 1A49 49 0 0 0 50 99" stroke-width="7.0" />
          <path d="M22 9.8V90.2" stroke-width="6.5" />
          <path d="M36 3V97" stroke-width="4.0" />
          <path d="M50 1A49 49 0 0 1 99 50A30.3 30.3 0 0 1 68.7 80.3A18.7 18.7 0 0 1 50 61.6A11.6 11.6 0 0 1 61.6 50" stroke-width="7.0" />
        </g>
      </svg>
      <span class="wordmark">Craft <span class="wordmark-with">with</span> Intent</span>
    </a>

    <nav aria-label="Main" class="desktop-nav">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={['nav-link', { 'is-current': current === link.id }]}
          aria-current={current === link.id ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a href="#subscribe" class="header-subscribe">Subscribe</a>
    </nav>

    <button
      type="button"
      class="menu-toggle"
      id="mobile-menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu-sheet"
    >
      <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true">
        <path d="M0 1H18M0 6H18M0 11H18" stroke="#111111" stroke-width="1.6" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu-sheet" class="mobile-sheet" hidden>
    <nav aria-label="Mobile" class="mobile-nav">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={['mobile-nav-link', { 'is-current': current === link.id }]}
          aria-current={current === link.id ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a href="#subscribe" class="mobile-subscribe">Subscribe</a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById('mobile-menu-toggle');
    const sheet = document.getElementById('mobile-menu-sheet');
    if (!btn || !sheet) return;

    const close = (restoreFocus) => {
      if (sheet.hidden) return;
      sheet.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (restoreFocus) btn.focus();
    };

    const open = () => {
      sheet.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      const firstLink = sheet.querySelector('a');
      if (firstLink) firstLink.focus();
    };

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (sheet.hidden) open();
      else close(true);
    });

    sheet.addEventListener('click', (e) => {
      if (e.target && e.target.closest('a')) close(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close(true);
    });

    document.addEventListener('click', (e) => {
      if (!sheet.hidden && !sheet.contains(e.target) && !btn.contains(e.target)) {
        close(false);
      }
    });
  })();
</script>

<style>
  .site-header {
    border-bottom: var(--rule);
    background: var(--color-canvas);
    position: relative;
    z-index: 30;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--color-ink);
    min-height: var(--tap-min);
    flex-shrink: 0;
  }
  .lockup:hover { color: var(--color-ink); }
  .lockup-mark {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
  }
  .wordmark {
    font-family: var(--font-logo);
    font-size: 21px;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 48;
  }
  .wordmark-with {
    font-style: italic;
    font-weight: 300;
    font-variation-settings: 'opsz' 48, 'SOFT' 100, 'WONK' 1;
  }
  .desktop-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
  }
  .nav-link {
    padding: 12px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-ink);
  }
  .nav-link:hover { color: var(--color-accent); }
  .nav-link.is-current {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  .header-subscribe {
    margin-left: 10px;
    display: inline-flex;
    align-items: center;
    height: var(--tap-min);
    padding: 0 20px;
    background: var(--color-ink);
    color: var(--color-canvas);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }
  .header-subscribe:hover {
    background: #2A2A2A;
    color: var(--color-canvas);
  }
  .menu-toggle {
    display: none;
    width: var(--tap-min);
    height: var(--tap-min);
    border: var(--rule);
    background: var(--color-canvas);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }
  .mobile-sheet {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-canvas);
    border-bottom: var(--rule-strong);
    box-shadow: 0 24px 48px rgba(17, 17, 17, 0.14);
    z-index: 40;
    animation: slideSheet var(--dur-base) var(--ease);
  }
  @keyframes slideSheet {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .mobile-nav {
    display: flex;
    flex-direction: column;
    padding: 12px 16px 24px;
  }
  .mobile-nav-link {
    padding: 14px 0;
    border-bottom: var(--rule);
    font-size: 20px;
    font-weight: 500;
    text-decoration: none;
  }
  .mobile-nav-link.is-current {
    font-weight: 600;
    color: var(--color-accent);
  }
  .mobile-subscribe {
    margin-top: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    background: var(--color-ink);
    color: var(--color-canvas);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 767px) {
    .desktop-nav { display: none; }
    .menu-toggle { display: inline-flex; }
    .lockup-mark { width: 26px; height: 26px; }
    .wordmark {
      font-size: 18px;
      font-variation-settings: 'opsz' 36;
    }
    .wordmark-with {
      font-variation-settings: 'opsz' 36, 'SOFT' 100, 'WONK' 1;
    }
  }
</style>
