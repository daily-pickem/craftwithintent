---
import BaseLayout from '../layouts/BaseLayout.astro';
import FounderCard from '../components/FounderCard.astro';
import { FOUNDER_LIST, CHARTER_ITEMS } from '../lib/site';
---
<BaseLayout
  title="Founders & Honesty Charter — Craft with Intent"
  description="Three crafts at one table: Andy Chiang (Design), Mike (Engineering), and Awesome (Product), plus our honesty and attribution charter."
  current="founders"
  subscribeId="founders-email"
>
  <section class="container founders-hero">
    <span class="meta-label">THE BUILDERS</span>
    <h1 class="founders-h1">Three crafts.<br />One table.</h1>
    <p class="founders-intro">
      Product, design and engineering catch each other's blind spots, and AI's. Between us, more than sixty years of shipping consumer apps, games and AI systems.
    </p>
  </section>

  <section class="container founders-grid-wrap">
    <div class="founders-grid">
      {FOUNDER_LIST.map((founder) => (
        <FounderCard founder={founder} />
      ))}
    </div>
  </section>

  <section id="charter" class="charter-section">
    <div class="container charter-flex">
      <div class="charter-left">
        <span class="charter-eyebrow mono">OUR CHARTER</span>
        <h2 class="charter-h2">Honesty &amp; attribution</h2>
        <p class="charter-sub">How we measure real outcomes, and lose in public.</p>
      </div>

      <div class="charter-right">
        {CHARTER_ITEMS.map((item) => (
          <div class="charter-row">
            <span class="charter-num mono">{item.n}</span>
            <div class="charter-copy">
              <strong>{item.title}</strong>
              <span>{item.body}</span>
            </div>
          </div>
        ))}
        <div class="charter-end" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .founders-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .founders-h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }
  .founders-intro {
    margin: 0;
    font-size: var(--text-body-lg);
    line-height: 1.65;
    color: var(--color-ink-secondary);
    max-width: 62ch;
  }
  .founders-grid-wrap {
    padding-bottom: var(--space-16);
  }
  .founders-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--space-10);
  }
  .charter-section {
    background: var(--color-surface);
  }
  .charter-flex {
    padding-top: var(--space-16);
    padding-bottom: var(--space-18);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
  }
  .charter-left {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .charter-eyebrow {
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    color: var(--color-accent);
  }
  .charter-h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(30px, 3.4vw, 42px);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
  }
  .charter-sub {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 24px;
    line-height: 1.3;
    color: var(--color-ink-secondary);
  }
  .charter-right {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .charter-row {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    padding: 22px 0;
    border-top: var(--rule);
  }
  .charter-num {
    font-size: 13px;
    color: var(--color-accent);
  }
  .charter-copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .charter-copy strong { font-size: 18px; }
  .charter-copy span {
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-ink-secondary);
  }
  .charter-end { border-top: var(--rule); }
</style>
